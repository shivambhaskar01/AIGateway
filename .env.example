# Copy to .env and replace the placeholders. Never commit .env.
# Generate a gateway key with: python -c "import secrets; print(secrets.token_urlsafe(32))"

LLM_GATEWAY_ENV=development
LLM_GATEWAY_HOST=127.0.0.1
LLM_GATEWAY_PORT=8080
LLM_GATEWAY_API_KEY=replace-with-a-long-random-string
LLM_GATEWAY_LOG_LEVEL=INFO
LLM_GATEWAY_LOG_PROMPTS=false

# OpenAI-compatible endpoint: OpenAI, Azure OpenAI, Groq, Together, vLLM, or a LiteLLM proxy.
# Leave the key empty until you are ready to call a provider. The process will not invent one.
LLM_GATEWAY_PROVIDER_API_KEY=
LLM_GATEWAY_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_GATEWAY_MODEL_FAST=gpt-4o-mini
LLM_GATEWAY_MODEL_STRONG=gpt-4o
LLM_GATEWAY_MODEL_FALLBACK=gpt-4o-mini
LLM_GATEWAY_REQUEST_TIMEOUT_SECONDS=30

# Ledger. Leave the bucket empty to use the local disk cache.
# In a real account, prefer an instance or task role over long-lived keys.
LLM_GATEWAY_S3_BUCKET=
LLM_GATEWAY_S3_PREFIX=llm-gateway/cache/
LLM_GATEWAY_S3_REGION=us-east-1
LLM_GATEWAY_S3_EXPECTED_OWNER=
LLM_GATEWAY_CACHE_TTL_SECONDS=3600
LLM_GATEWAY_CACHE_DIR=.cache/llm-gateway

# Sentinel
LLM_GATEWAY_GUARDRAILS_ENABLED=true
LLM_GATEWAY_BLOCK_ON_SECRET=true
LLM_GATEWAY_BLOCK_ON_INJECTION=true
LLM_GATEWAY_REDACT_PII=true
LLM_GATEWAY_FAST_TIER_MAX_CHARS=800
LLM_GATEWAY_MAX_PROMPT_CHARS=16000
LLM_GATEWAY_RATE_LIMIT_RPM=60
LLM_GATEWAY_TRUST_PROXY=false

# Beacon. Set an endpoint only if you run an OpenTelemetry collector.
LLM_GATEWAY_OTLP_ENDPOINT=
